# Environment Configuration
ENVIRONMENT=development
DEBUG=True

# Application Settings
PROJECT_NAME="Real-Time Food Delivery Tracking and Route optimization"
API_V1_STR=/api/v1
SECRET_KEY=replace-with-a-new-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings
# For local development with SQLite (Async):
DATABASE_URL=sqlite+aiosqlite:///./food_delivery.db
# For PostgreSQL (Docker / Production):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/food_delivery_db

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
